#!/usr/bin/env bash
# mcp-curl — send a single MCP JSON-RPC call over streamable-http
#
# Usage:
#   ./mcp-curl tools/list
#   ./mcp-curl tools/call '{"name":"nf_lifecycle","arguments":{"action":"status"}}'
#   ./mcp-curl tools/call '{"name":"nf_lifecycle","arguments":{"action":"status","nf":["amf"]}}'
#
# Env:
#   MCP_URL  — base URL of the MCP endpoint (default: http://localhost:8080/mcp)

set -euo pipefail

usage() {
    cat <<'EOF'
mcp-curl — send a single MCP JSON-RPC call over streamable-http

USAGE
  ./mcp-curl [METHOD] [PARAMS_JSON]

ARGUMENTS
  METHOD       JSON-RPC method (default: tools/list)
  PARAMS_JSON  JSON params object (default: {})

COMMANDS
  tools/list                           List all registered tools
  tools/call  '{"name":"<tool>","arguments":{...}}'   Call a tool

ENV
  MCP_URL      MCP endpoint URL (default: http://localhost:8080/mcp)

NOTES
  The server must be running (any transport). The default "all" transport
  serves both SSE (/sse for ollmcp) and streamable-http (/mcp for mcp-curl)
  on the same port — no restart needed.
    ./open5gs-mcp start    # default: all transports on port 8080

EXAMPLES
  ./mcp-curl tools/list

  ./mcp-curl tools/call '{"name":"nf_lifecycle","arguments":{"action":"status"}}'
  ./mcp-curl tools/call '{"name":"nf_lifecycle","arguments":{"action":"status","nf":["amf","smf"]}}'
  ./mcp-curl tools/call '{"name":"nf_lifecycle","arguments":{"action":"start"}}'

  ./mcp-curl tools/call '{"name":"system_health_snapshot","arguments":{}}'
  ./mcp-curl tools/call '{"name":"system_health_snapshot","arguments":{"log_minutes":30}}'

  ./mcp-curl tools/call '{"name":"subscriber_crud","arguments":{"operation":"list"}}'
  ./mcp-curl tools/call '{"name":"subscriber_crud","arguments":{"operation":"read","imsi":"999700000000001"}}'
  ./mcp-curl tools/call '{"name":"subscriber_crud","arguments":{"operation":"create","imsi":"999700000000002","data":{"security":{"k":"465B5CE8B199B49FAA5F0A2EE238A6BC","opc":"E8ED289DEBA952E4283B54E88E6183CA"}}}}'
  ./mcp-curl tools/call '{"name":"subscriber_crud","arguments":{"operation":"delete","imsi":"999700000000002"}}'

  ./mcp-curl tools/call '{"name":"list_ue_sessions","arguments":{}}'
  ./mcp-curl tools/call '{"name":"list_ue_sessions","arguments":{"imsi_filter":"999700","include_idle":false}}'

  ./mcp-curl tools/call '{"name":"tail_nf_logs","arguments":{"nf":"amf","level":"info","lines":20}}'
  ./mcp-curl tools/call '{"name":"tail_nf_logs","arguments":{"nf":["amf","ausf","udm"],"grep":"imsi-999700000000001","since":"15m"}}'
  ./mcp-curl tools/call '{"name":"tail_nf_logs","arguments":{"nf":"all","level":"error","since":"1h"}}'

  MCP_URL=http://192.168.64.19:8080/mcp ./mcp-curl tools/list
EOF
    exit 0
}

[[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && usage

MCP_URL="${MCP_URL:-http://localhost:8080/mcp}"
METHOD="${1:-tools/list}"
_default_params='{}'
PARAMS="${2:-$_default_params}"

# ── helpers ────────────────────────────────────────────────────────────────────

post() {
    local session="${1:-}" body="$2"
    local hdrs=(-H "Content-Type: application/json" -H "Accept: application/json, text/event-stream")
    [[ -n $session ]] && hdrs+=(-H "Mcp-Session-Id: $session")
    local tmp; tmp=$(mktemp)
    printf '%s' "$body" > "$tmp"
    curl -s "${hdrs[@]}" -X POST "$MCP_URL" --data-binary "@$tmp"
    rm -f "$tmp"
}

# Extract the SSE data line from a response (strips "data: " prefix)
sse_data() {
    local tmp; tmp=$(mktemp)
    cat > "$tmp"
    local data; data=$(grep -o 'data:.*' "$tmp" | head -1 | sed 's/^data: //')
    if [[ -z $data ]]; then
        echo "ERROR: no SSE data in response:" >&2
        cat "$tmp" >&2
        rm -f "$tmp"
        exit 1
    fi
    rm -f "$tmp"
    printf '%s' "$data"
}

die() { echo "ERROR: $*" >&2; exit 1; }

# ── handshake ──────────────────────────────────────────────────────────────────

INIT_RESPONSE=$(curl -si \
    -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -X POST "$MCP_URL" \
    -d '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"mcp-curl","version":"1"}}}')

# Extract HTTP status from the first line of the response
HTTP_INIT_STATUS=$(echo "$INIT_RESPONSE" | head -1 | grep -oP '\d{3}' | head -1 || true)
if [[ $HTTP_INIT_STATUS == "404" ]]; then
    die "Server returned 404 — it is probably running SSE transport, not streamable-http.
Restart with: ./open5gs-mcp restart --transport streamable-http"
fi

# || true prevents set -e from killing the script when grep finds no header
SESSION=$(echo "$INIT_RESPONSE" | grep -i "^mcp-session-id:" | awk '{print $2}' | tr -d '\r' || true)
[[ -n $SESSION ]] || die "No Mcp-Session-Id in response — is the server running at $MCP_URL?"

# Send initialized notification (fire-and-forget, no response expected)
post "$SESSION" '{"jsonrpc":"2.0","method":"notifications/initialized","params":{}}' > /dev/null

# ── actual call ────────────────────────────────────────────────────────────────

BODY=$(printf '{"jsonrpc":"2.0","id":1,"method":"%s","params":%s}' "$METHOD" "$PARAMS")
HDRS=(-H "Content-Type: application/json"
      -H "Accept: application/json, text/event-stream"
      -H "Mcp-Session-Id: $SESSION")

REQ_BODY=$(mktemp)
printf '%s' "$BODY" > "$REQ_BODY"
RESP_BODY=$(mktemp)
HTTP_STATUS=$(curl -s -o "$RESP_BODY" -w "%{http_code}" \
    "${HDRS[@]}" -X POST "$MCP_URL" --data-binary "@$REQ_BODY")
rm -f "$REQ_BODY"

if [[ $HTTP_STATUS != 200 ]]; then
    echo "ERROR: HTTP $HTTP_STATUS from server:" >&2
    cat "$RESP_BODY" >&2
    rm -f "$RESP_BODY"
    exit 1
fi

cat "$RESP_BODY" | sse_data | python3 -m json.tool
rm -f "$RESP_BODY"
